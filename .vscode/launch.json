    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "tt-lint-lldb",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "-p",
                "/home/user/tt-kernel-lint/tmp",
                "/home/user/tt-kernel-lint/tt-metal/tt_metal/hw/firmware/src/tt-1xx/trisck.cc",
                "/home/user/tt-kernel-lint/tt-metal/tt_metal/hw/firmware/src/tt-1xx/trisc.cc",
                "/home/user/tt-kernel-lint/tt-metal/tt_metal/hw/firmware/src/tt-1xx/trisc.cc"
            ],
            "cwd": "${workspaceFolder}"
        },
    ]
}
    {"type": "rectangle", "id": "op", "x": 500, "y": 580, "width": 440, "height": 170, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2141, "version": 1, "versionNonce": 3141, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3}},
    {"type": "text", "id": "op_t", "x": 520, "y": 600, "width": 400, "height": 130, "text": "OperationUse\n\noperation         : \"add_tiles\"\ninitializer       : \"add_init\"\ncall_site         : \"file:line:col\"\nguaranteed_before : InitMask", "originalText": "OperationUse\n\noperation         : \"add_tiles\"\ninitializer       : \"add_init\"\ncall_site         : \"file:line:col\"\nguaranteed_before : InitMask", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2142, "version": 1, "versionNonce": 3142, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35},

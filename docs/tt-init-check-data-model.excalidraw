    {"type": "rectangle", "id": "fg", "x": 500, "y": 285, "width": 500, "height": 210, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2111, "version": 1, "versionNonce": 3111, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3}},
    {"type": "text", "id": "fg_t", "x": 520, "y": 300, "width": 460, "height": 180, "text": "FunctionGraph\n\nentry, exit         : unsigned\nguarantees          : InitMask\nblocks              : unordered_map<unsigned, CfgBlock>\nops                 : map<site+init, OperationUse>", "originalText": "FunctionGraph\n\nentry, exit         : unsigned\nguarantees          : InitMask\nblocks              : unordered_map<unsigned, CfgBlock>\nops                 : map<site+init, OperationUse>", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2112, "version": 1, "versionNonce": 3112, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35},


    {"type": "text", "id": "note1", "x": 80, "y": 1015, "width": 900, "height": 18, "text": "All maps are local to run(). Only findings_ outlives the call.", "originalText": "All maps are local to run(). Only findings_ outlives the call.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2171, "version": 1, "versionNonce": 3171, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},
    {"type": "text", "id": "note2", "x": 80, "y": 1039, "width": 1000, "height": 18, "text": "A call without a definition has a CallSite but no FunctionGraph (opaque).", "originalText": "A call without a definition has a CallSite but no FunctionGraph (opaque).", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2172, "version": 1, "versionNonce": 3172, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},
    {"type": "text", "id": "footer", "x": 80, "y": 1073, "width": 1400, "height": 20, "text": "Solid = ownership or flow · Dashed = cross-reference or type reference", "originalText": "Solid = ownership or flow · Dashed = cross-reference or type reference", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2173, "version": 1, "versionNonce": 3173, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}

    {"type": "text", "id": "subtitle", "x": 60, "y": 76, "width": 1400, "height": 22, "text": "Built per Context inside run(); keyed by Clang USR; initializer sets are 32-bit masks.", "originalText": "Built per Context inside run(); keyed by Clang USR; initializer sets are 32-bit masks.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2002, "version": 1, "versionNonce": 3002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},


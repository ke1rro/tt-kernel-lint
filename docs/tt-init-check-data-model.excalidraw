    {"type": "rectangle", "id": "call", "x": 80, "y": 800, "width": 360, "height": 150, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2131, "version": 1, "versionNonce": 3131, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3}},
    {"type": "text", "id": "call_t", "x": 100, "y": 820, "width": 320, "height": 110, "text": "CallSite\n\nusr       : callee USR\nname      : \"add_tiles\"\ncall_site : \"file:line:col\"", "originalText": "CallSite\n\nusr       : callee USR\nname      : \"add_tiles\"\ncall_site : \"file:line:col\"", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2132, "version": 1, "versionNonce": 3132, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35},

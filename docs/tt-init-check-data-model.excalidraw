    {"type": "rectangle", "id": "mask", "x": 1000, "y": 580, "width": 460, "height": 300, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2151, "version": 1, "versionNonce": 3151, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3}},
    {"type": "text", "id": "mask_t", "x": 1020, "y": 600, "width": 420, "height": 260, "text": "InitMask = uint32_t\nbit i = kInitializers.names[i]\n\nkPairRules: operation -> initializer\n  add_tiles   -> add_init\n  mul_tiles   -> mul_init\n  copy_tile   -> copy_init\n\nkInitializers: distinct names, <= 16\n  add_init(0) sub_init(1) mul_init(2)\n  ... matmul_block_init(8)\n\nInitializerMask(name) -> bit | 0", "originalText": "InitMask = uint32_t\nbit i = kInitializers.names[i]\n\nkPairRules: operation -> initializer\n  add_tiles   -> add_init\n  mul_tiles   -> mul_init\n  copy_tile   -> copy_init\n\nkInitializers: distinct names, <= 16\n  add_init(0) sub_init(1) mul_init(2)\n  ... matmul_block_init(8)\n\nInitializerMask(name) -> bit | 0", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2152, "version": 1, "versionNonce": 3152, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35},

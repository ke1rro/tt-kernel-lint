    {"type": "text", "id": "evidence_t", "x": 1044, "y": 872, "width": 432, "height": 156, "text": "G(setup)        = {add_init}\nops(do_add)     = add_tiles, pre = ∅\nops(kernel_main)= add_tiles, pre = {add_init}\n=> no finding\n\nswapped order\nops(kernel_main)= add_tiles, pre = ∅\n=> finding", "originalText": "G(setup)        = {add_init}\nops(do_add)     = add_tiles, pre = ∅\nops(kernel_main)= add_tiles, pre = {add_init}\n=> no finding\n\nswapped order\nops(kernel_main)= add_tiles, pre = ∅\n=> finding", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 1264, "version": 1, "versionNonce": 2264, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35},

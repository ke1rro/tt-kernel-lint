export TT_METAL_HOME="$PWD/tt-metal"
export TT_METAL_RUNTIME_ROOT="$PWD/tt-metal"
export TT_METAL_SIMULATOR="$PWD/ttsim/src/_out/release_wh/libttsim.so"
export TT_METAL_SLOW_DISPATCH_MODE=1
export TT_METAL_FORCE_JIT_COMPILE=1
export TT_METAL_LOG_KERNELS_COMPILE_COMMANDS=1
export TT_LOGGER_LEVEL=info
export CCACHE_DISABLE=1
export TT_METAL_CACHE="$(mktemp -d "$PWD/tt-kernel-lint-captures/demo.XXXXXX")"
export TTKL_INPUT_LOG="$PWD/tt-kernel-lint-captures/baseline.sMqv3U/jit.log"
unset TT_METAL_CCACHE_KERNEL_SUPPORT TT_METAL_JIT_SERVER_ENABLE
unset TT_LOGGER_FILE TT_METAL_LOGGER_FILE
